    "/api/v1/chat.sendMessage": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Send a message",
        "description": "Optional tmid posts a thread reply; optional attachments carries image payloads.",
        "security": [
          {
            "authToken": [],
            "userId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "object",
                    "required": [
                      "rid",
                      "msg"
                    ],
                    "properties": {
                      "rid": {
                        "type": "string"
                      },
                      "msg": {
                        "type": "string"
                      },
                      "tmid": {
                        "type": "string"
                      },
                      "attachments": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/ImageAttachment"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "$ref": "#/components/schemas/Message"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat.update": {
