{
  "openapi": "3.0.3",
  "info": {
    "title": "blazer-chat \u2014 Rocket.Chat REST contract",
    "version": "0.1.0",
    "description": "The exact REST subset blazer-chat consumes, documented from the wire code (src/rc/wire.rs, src/rc/client.rs). The server returns more fields than listed; unknown fields are ignored by the decoder.\n\nLive updates are NOT REST: a DDP session over wss://{host}/websocket authenticates with {msg: 'login', params: [{resume: authToken}]} and subscribes to streamer events; message bodies follow the Message schema with EJSON dates (ts may be a string or {$date: string}).\n\nGuard: `just api-check` fails the gate if client code calls an endpoint missing from this spec."
  },
  "servers": [
    {
      "url": "https://chat.example.com"
    }
  ],
  "security": [
    {
      "authToken": [],
      "userId": []
    }
  ],
  "components": {
    "securitySchemes": {
      "authToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Auth-Token"
      },
      "userId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Id"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "EjsonDate": {
        "description": "RFC3339 string over REST; {$date: string} over DDP.",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "$date": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "File": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "ImageAttachment": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string"
          },
          "image_type": {
            "type": "string"
          },
          "image_size": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Reaction": {
        "type": "object",
        "properties": {
          "usernames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      },
      "Message": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "rid": {
            "type": "string"
          },
          "msg": {
            "type": "string"
          },
          "ts": {
            "$ref": "#/components/schemas/EjsonDate"
          },
          "u": {
            "$ref": "#/components/schemas/User"
          },
          "tmid": {
            "type": "string",
            "description": "thread parent id when this is a thread reply"
          },
          "tcount": {
            "type": "integer",
            "description": "reply count when this message starts a thread"
          },
          "tlm": {
            "$ref": "#/components/schemas/EjsonDate"
          },
          "editedAt": {
            "$ref": "#/components/schemas/EjsonDate"
          },
          "reactions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Reaction"
            }
          },
          "file": {
            "$ref": "#/components/schemas/File"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageAttachment"
            }
          }
        },
        "additionalProperties": true
      },
      "Room": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "t": {
            "type": "string",
            "description": "c channel, p private group, d direct"
          },
          "name": {
            "type": "string"
          },
          "usernames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lm": {
            "type": "string"
          },
          "lastMessage": {
            "type": "object",
            "properties": {
              "msg": {
                "type": "string"
              },
              "u": {
                "$ref": "#/components/schemas/User"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "rid": {
            "type": "string"
          },
          "unread": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "Emoji": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extension": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "userId": {
                "type": "string"
              },
              "authToken": {
                "type": "string"
              },
              "me": {
                "$ref": "#/components/schemas/User"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/api/v1/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Password login",
        "description": "POST {user, password}; the returned authToken resumes sessions (REST headers and DDP resume).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user",
                  "password"
                ],
                "properties": {
                  "user": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Invalidate the session",
        "description": "Server-side logout; the client then forgets the stored token.",
        "security": [
          {
            "authToken": [],
            "userId": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rooms.get": {
      "get": {
        "tags": [
          "rooms"
        ],
        "summary": "Room list",
        "description": "All rooms of the account; the sidebar sorts by lm.",
        "security": [
          {
            "authToken": [],
            "userId": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "update": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Room"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions.get": {
      "get": {
        "tags": [
          "rooms"
        ],
        "summary": "Subscription state",
        "description": "Per-user unread counts merged into the room list.",
        "security": [
          {
            "authToken": [],
            "userId": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "update": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Subscription"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions.read": {
      "post": {
        "tags": [
          "rooms"
        ],
        "summary": "Mark room read",
        "description": "Server-side read receipt; stops the unread stream counting the room.",
        "security": [
          {
            "authToken": [],
            "userId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "rid"
                ],
                "properties": {
                  "rid": {
                    "type": "string"
                  },
                  "unread": {
                    "type": "boolean",
                    "description": "Set true to flag the room unread instead of read."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions.delete": {
      "delete": {
        "tags": [
          "rooms"
        ],
        "summary": "Hide room",
        "description": "Removes the room from the account's subscription list (sidebar Hide).",
        "security": [
          {
            "authToken": [],
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "roomId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
